{
  "info": {
    "name": "MBGA Delivery API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": ""
    },
    {
      "key": "mobile_number",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "request_id",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "onboarding_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "logout"
          ]
        }
      }
    },
    {
      "name": "Logout All",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/logout-all",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "logout-all"
          ]
        }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Request Otp",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/otp/request",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "otp",
            "request"
          ]
        }
      }
    },
    {
      "name": "Resend Otp",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/otp/resend",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "otp",
            "resend"
          ]
        }
      }
    },
    {
      "name": "Verify Otp",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/otp/verify",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "otp",
            "verify"
          ]
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/delivery/auth/token/refresh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "delivery",
            "auth",
            "token",
            "refresh"
          ]
        }
      }
    }
  ]
}
