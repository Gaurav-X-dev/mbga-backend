[Unit]
Description=MBGA Credit Reminder Scheduler
After=network-online.target mbga-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mbga-backend/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/mbga-backend/backend/venv/bin/python /home/ubuntu/mbga-backend/backend/scripts/send_credit_reminders.py

[Install]
WantedBy=multi-user.target
