# Application
APP_NAME="MBGA Backend"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1
ALLOWED_CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
TRUSTED_PROXY_IPS='[]'

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mbga
MYSQL_USER=mbga_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
DATABASE_URL=mysql+asyncmy://mbga_user:CHANGE_ME@127.0.0.1:3306/mbga?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://mbga_test_user:CHANGE_ME@127.0.0.1:3306/mbga_test?charset=utf8mb4

# Redis (permission cache only; permission checks fall back to the database)
# REDIS_ENABLED=false skips Redis entirely and is accepted only when APP_ENV is local/development/test.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_FAILURE_BACKOFF_SECONDS=30

# JWT
JWT_ALGORITHM=HS256
# Outside local/test: a random value of at least 32 bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_SECRET=change-me-local-only
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

# OTP
OTP_LENGTH=4
OTP_EXPIRES_SECONDS=300
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5
DEV_FIXED_OTP_ENABLED=false
# Local only: numeric, OTP_LENGTH digits.
DEV_FIXED_OTP_CODE=
# Local only: echoes the plaintext code as `dev_otp` in the OTP request/resend response so app
# developers can sign in before SMS auto-read is wired up. Anyone who can call the endpoint can then
# sign in as any account, so never enable this on a shared or production environment.
DEV_EXPOSE_OTP_IN_RESPONSE=false
OTP_REQUEST_LIMIT_PER_IP=20
OTP_REQUEST_LIMIT_PER_DEVICE=10
OTP_VERIFY_LIMIT_PER_IP=60
CHECK_MOBILE_LIMIT_PER_IP=30
OTP_MAX_FAILED_ATTEMPTS_PER_HOUR=10
REFRESH_REUSE_GRACE_SECONDS=10
AUTH_AUDIT_STORE_IP=true
PERMISSION_CACHE_TTL_SECONDS=300

# SMS Provider: mock (local/test only) or sms. Real vendor integration is pending vendor selection.
SMS_PROVIDER=mock
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TIMEOUT_SECONDS=5
SMS_MAX_RETRIES=2

# Swagger/OpenAPI pages. Unset = enabled only when APP_ENV is local/development/test.
# API_DOCS_ENABLED=false

# RBAC bootstrap. Keep disabled unless intentionally bootstrapping a local/disposable environment.
RBAC_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
RBAC_BOOTSTRAP_SUPER_ADMIN_USER_ID=
RBAC_BOOTSTRAP_SUPER_ADMIN_EMAIL=
RBAC_BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
RBAC_BOOTSTRAP_SUPER_ADMIN_FULL_NAME="Super Admin"
RBAC_BOOTSTRAP_SUPER_ADMIN_MOBILE_NUMBER=
RBAC_BOOTSTRAP_SUPER_ADMIN_COUNTRY_CODE=+91
