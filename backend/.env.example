# Application
APP_NAME="MBGA Backend"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1
ALLOWED_CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
TRUSTED_PROXY_IPS='[]'

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mbga
MYSQL_USER=mbga_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
DATABASE_URL=mysql+asyncmy://mbga_user:CHANGE_ME@127.0.0.1:3306/mbga?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://mbga_test_user:CHANGE_ME@127.0.0.1:3306/mbga_test?charset=utf8mb4

# Redis (permission cache only; permission checks fall back to the database)
# REDIS_ENABLED=false skips Redis entirely and is accepted only when APP_ENV is local/development/test.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_FAILURE_BACKOFF_SECONDS=30

# JWT
JWT_ALGORITHM=HS256
# Outside local/test: a random value of at least 32 bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_SECRET=change-me-local-only
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

# OTP
OTP_LENGTH=4
OTP_EXPIRES_SECONDS=300
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5
DEV_FIXED_OTP_ENABLED=false
# Local only: numeric, OTP_LENGTH digits.
DEV_FIXED_OTP_CODE=
# Local only: echoes the plaintext code as `dev_otp` in the OTP request/resend response so app
# developers can sign in before SMS auto-read is wired up. Anyone who can call the endpoint can then
# sign in as any account, so never enable this on a shared or production environment.
DEV_EXPOSE_OTP_IN_RESPONSE=false
OTP_REQUEST_LIMIT_PER_IP=20
OTP_REQUEST_LIMIT_PER_DEVICE=10
OTP_VERIFY_LIMIT_PER_IP=60
CHECK_MOBILE_LIMIT_PER_IP=30
OTP_MAX_FAILED_ATTEMPTS_PER_HOUR=10
REFRESH_REUSE_GRACE_SECONDS=10
AUTH_AUDIT_STORE_IP=true
PERMISSION_CACHE_TTL_SECONDS=300

# SMS Provider: mock (local/test only), hanuotp, or sms (unimplemented vendor stub).
# One provider serves every login channel: Customer, Customer registration, Merchant,
# Delivery and Admin.
SMS_PROVIDER=mock
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TIMEOUT_SECONDS=5
SMS_MAX_RETRIES=2

# HanuOTP. Used only when SMS_PROVIDER=hanuotp. The backend generates the OTP; HanuOTP only
# delivers it. Startup fails if the provider is selected with any of the first three unset.
HANUOTP_BASE_URL=https://api.hanuotp.in/sms-otp.php
# Never commit a real key. Put it in .env (git-ignored) only.
HANUOTP_API_KEY=
HANUOTP_TEMPLATE_ID=default
HANUOTP_TIMEOUT_SECONDS=10
# Zero on purpose: the vendor bills per message and the OTP flow has its own resend throttle,
# so a failed send is reported rather than silently retried into a second charge.
HANUOTP_MAX_RETRIES=0
# The endpoint sits behind bot protection that occasionally answers with an HTML
# challenge page. No message is sent in that case, so retrying it is free.
HANUOTP_EDGE_BLOCK_RETRIES=2
# Guards scripts/smoke_test_hanuotp.py, which sends exactly one real SMS. Local/dev only.
HANUOTP_LIVE_SMOKE_TEST_ENABLED=false
HANUOTP_SMOKE_TEST_MOBILE=

# Swagger/OpenAPI pages. Unset = enabled only when APP_ENV is local/development/test.
# API_DOCS_ENABLED=false

# RBAC bootstrap. Keep disabled unless intentionally bootstrapping a local/disposable environment.
RBAC_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
RBAC_BOOTSTRAP_SUPER_ADMIN_USER_ID=
RBAC_BOOTSTRAP_SUPER_ADMIN_EMAIL=
RBAC_BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
RBAC_BOOTSTRAP_SUPER_ADMIN_FULL_NAME="Super Admin"
RBAC_BOOTSTRAP_SUPER_ADMIN_MOBILE_NUMBER=
RBAC_BOOTSTRAP_SUPER_ADMIN_COUNTRY_CODE=+91

# --- KYC document scanning -----------------------------------------------------------------
# No malware scanner is wired up yet, so every upload is recorded as SKIPPED. Approval
# normally demands CLEAN; this allows SKIPPED so merchant staff can actually approve a
# customer on this development server.
# It has no effect outside local/development/test - production always demands CLEAN, which
# means a real scanner (or a written decision to accept unscanned documents) is a production
# blocker, not something this flag can solve.
ALLOW_SKIPPED_KYC_SCAN_IN_LOCAL=false
# How long a staged-but-never-attached upload is kept before the cleanup script may delete it.
STAGED_UPLOAD_RETENTION_HOURS=24
